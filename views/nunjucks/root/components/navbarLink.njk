{% macro navbar(params) %}
    {% for link in params.links %}
        {{ navbarLink(link) }}
    {% endfor %}
{% endmacro %}

{% macro navbarLink(params) %}
    <li {% if params.active %}class="active"{% endif %}><a href="{{ params.href }}" {% if params.active %}aria-current="page"{% endif %}>{{ params.text }}</a></li>
{% endmacro %}
