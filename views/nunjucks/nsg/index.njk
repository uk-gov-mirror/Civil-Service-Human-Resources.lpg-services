{% extends "./baseLayout.njk" %}

{% block pageTitle %}
    National School of Government and Public Services
{% endblock %}

{% set navbarTab = "home" %}

{% macro categoryCard(params) %}
    <div class='category-card'>
        <div class='category-card__header-block'>
            <h2 class='category-card__heading category-card__heading--small'>{{ params.title }}</h2>
        </div>
        <div class='category-card__content'>
            <div class='category-card__content-block'>
                <p class='govuk-body'>
                    {{ params.description }}
                </p>
            </div>
            <div class='category-card__action-block'>
                <a class='govuk-link' href='{{ params.fullUrl }}'>View subjects</a>
            </div>
        </div>
    </div>
{% endmacro %}

{% block content %}
    <div class='govuk-grid-row'>
        <div class='govuk-grid-column-one-third'>
            <div class='title-card'>
                <h1 class='title-card__heading title-card__heading--medium'>Welcome to the National School of Government and Public Services.</h1>
                <div class='title-card__content'>
                    <p class='govuk-body'>The National School provides world-class learning and development for civil servants, supporting public sector excellence and preparing our people for the future.</p>
                    <p class='govuk-body'>Click on the link to view the subjects.</p>
                </div>
            </div>
        </div>
        <div class='govuk-grid-column-two-thirds'>
            <div class='category-card__container'>
                {% for category in homepage.categories %}
                    {{ categoryCard(category) }}
                {% endfor %}
            </div>
        </div>
    </div>
{% endblock %}

{% block footer %}
    <div class='icon-banner__container'>
        <div class="icon-banner"></div>
    </div>
    {{ super() }}
{% endblock %}