        </svg>
        <a class="moj-header__link moj-header__link--organisation-name" href="https://gov.uk">GOV.UK</a>
        <a class="moj-header__link moj-header__link--service-name" href="/">Civil Service Learning</a>
    {% endset %}
    {{ govukGenericHeader({
        url: '/home',
        logoHtml: logoHtml,
        classes: "border-header"
    }) }}

    {{ govukServiceNavigation({
        navigation: [
            {
                href: "#",
                text: "Navigation item 1"
            },
            {
                href: "#",
                text: "Navigation item 2",
                active: true
            },
            {
                href: "#",
                text: "Navigation item 3"
            }
        ],
        slots: {
            navigationEnd: searchHtml
        }
    }) }}

{% endblock %}

{% block head %}
    <link rel="stylesheet" href="{{ staticAssetRoot }}/styles/main.v2.css">
{% endblock %}

{% block content %}
    <h1 class="govuk-heading-xl">Default page template</h1>
{% endblock %}

