{% extends "template.njk" %}

{% from "back-link/macro.njk" import govukBackLink %}
{% from "cookie-banner/macro.njk" import govukCookieBanner %}
{% from "skip-link/macro.njk" import govukSkipLink %}
{% from "header/macro.njk" import govukHeader %}
{% from "phase-banner/macro.njk" import govukPhaseBanner %}
{% from "footer/macro.njk" import govukFooter %}
{% from "generic-header/macro.njk" import govukGenericHeader %}
{% from "service-navigation/macro.njk" import govukServiceNavigation %}

{% set bodyClasses = "nsg-body" %}
{% set mainClasses = "nsg-homepage-main" %}
{% set containerClasses = "nsg-homepage-wide-container" %}

{% block pageTitle %}GOV.UK - Customised page template{% endblock %}

{% block bodyStart %}
    <div id="global-cookie-message">
        <p>
            Civil Service Learning uses cookies to make the site simpler.
            <a href="/cookies"> Find out more about cookies</a>
        </p>
    </div>
{% endblock %}

{% block govukSkipLink %}
    {{ govukSkipLink({
        href: "#main-content",
        text: "Skip to main content"
    }) }}
{% endblock %}

{% block header %}
    {% set logoHtml %}
